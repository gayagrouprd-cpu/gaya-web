---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import brand from '../../brand.json';
---

<Base lang="es" title={`404 · ${brand.name}`} noindex>
  <main id="contenido" class="nf">
    <Logo href="/" label={brand.name} />
    <div class="nf__body">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1>Página no encontrada <span lang="en">· Page not found</span></h1>
      <div class="nf__actions">
        <a class="btn btn--primary" href="/">Ir al inicio</a>
        <a class="btn btn--ghost" href="/en/" lang="en" hreflang="en">Go to homepage</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .nf {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100svh;
    padding: var(--space-6) var(--gutter) var(--space-8);
    background: radial-gradient(60rem 34rem at 12% 8%, color-mix(in oklch, var(--glow-1) 45%, transparent), transparent 70%) no-repeat, var(--surface);
  }
  .nf__body {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-5);
  }
  .nf__code {
    font-family: var(--font-mono);
    font-size: var(--text-display);
    font-weight: 500;
    line-height: 1;
    color: var(--accent-text);
  }
  /* Titular en Geist Mono (viene de base.css): «Página no encontrada» son 20 columnas de 0,58 em; 24 px es lo más grande que cabe
     en 320 px, y 22 caracteres de caja bastan para dos líneas («Página no encontrada» / «· Page not found»). */
  h1 {
    max-width: 22ch;
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.5rem);
    font-weight: 800;
    line-height: 1.1;
  }
  h1 span {
    color: var(--muted);
    font-weight: 400;
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
