---
// Inicio en español: estilo «cartel editorial» + ASCII (decisión del dueño, 5-oct-2026). Mismo componente que /en/, con `lang`.
import Base from '../layouts/Base.astro';
import Home from '../components/v3/Home.astro';
import { jsonLd } from '../lib/jsonld';
import { t } from '../i18n/copy';
import { url } from '../routes';
import '../styles/v3.css';

const lang = 'es';
---

<Base lang={lang} title={t(lang).home.title} routeKey="home" ui="poster" themeColor="#f2461a" jsonLd={jsonLd(lang, { pageUrl: url(lang, 'home') })}>
  <Home lang={lang} />
</Base>
