---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import PaletteDots from '../../components/PaletteDots.astro';
import brand from '../../../brand.json';
import { PALETTE_PICKER } from '../../data/site';
---

<Base lang="en" title={`${brand.name} · ${brand.tagline.en}`} routeKey="home">
  <Nav lang="en" />
  <main id="contenido">
    <Hero lang="en" />
  </main>
  {PALETTE_PICKER && <PaletteDots lang="en" />}
</Base>
