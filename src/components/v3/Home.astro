---
// Inicio en estilo «cartel editorial» + ASCII (decisión del dueño, 5-oct-2026). Un cartel por sección, a pantalla completa,
// alternando naranja, crema y negro. Pocas palabras por cartel (6-oct). Cada servicio lleva una escena 3D dibujada con
// caracteres (src/ascii3d): el primer cuadro sale del servidor y se ve sin JS; el navegador la anima.
import Icon from '../Icon.astro';
import Headline from './Headline.astro';
import brand from '../../../brand.json';
import { t } from '../../i18n/copy';
import { v3 } from '../../i18n/v3';
import { SERVICES, publishedLines, sectionId, type ServiceId } from '../../data/services';
import { render } from '../../ascii3d/render';
import { scene, STILL_T } from '../../ascii3d/scenes';
import { waGeneric, waServiceOf } from '../../lib/wa';
import { builtRefs, poster, refWhatsApp } from '../../lib/refs';
import { path, otherLang, type Lang } from '../../routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
const x = v3[lang];
const other = otherLang(lang);
const refs = builtRefs();
const id = (k: Parameters<typeof sectionId>[1]) => sectionId(lang, k);

// Tonos de cada cartel (se alternan; el de la portada es naranja como la referencia)
const SVC_TONE: Record<ServiceId, 'orange' | 'paper' | 'ink'> = { web: 'orange', automation: 'paper', marketing: 'ink', it: 'orange' };

// Primer cuadro de cada escena 3D (mismo tamaño de rejilla que usa el navegador en pantallas anchas)
const COLS = 76;
const ROWS = 38;
const still = Object.fromEntries(SERVICES.map((s) => [s.id, render(scene(s.id), { cols: COLS, rows: ROWS, dark: SVC_TONE[s.id] === 'ink' }, STILL_T, 0, 1)]));

/** Las líneas cortas de «Incluye» que están publicadas (las mismas banderas que services.ts). */
const shortIncludes = (sid: ServiceId) => {
  const s = SERVICES.find((v) => v.id === sid);
  const live = new Set(s ? publishedLines(s).map((l) => l.id) : []);
  return x.includes[sid].filter((l) => live.has(l.id));
};

const socials = Object.entries(brand.social) as Array<[keyof typeof c.contact.social, string]>;
const NUM = (n: number) => String(n).padStart(2, '0');
---

<div class="px-chrome">
  <div class="px-top">
    <a class="px-brand" href={`#${id('home')}`} aria-label={brand.name}><i aria-hidden="true"></i><span>{brand.name}</span></a>
    <nav class="px-links" aria-label={c.nav.label}>
      <a href={`#${id('about')}`}>{c.nav.about}</a>
      <a href={`#${id('services')}`}>{c.nav.services}</a>
      <a href={`#${id('samples')}`}>{c.nav.samples}</a>
      <a href={`#${id('process')}`}>{c.nav.process}</a>
      <a href={`#${id('contact')}`}>{c.nav.contact}</a>
    </nav>
    <a class="px-lang" href={path(other, 'home')} hreflang={other} lang={other} aria-label={c.nav.switchTo.label}>{c.nav.switchTo.code}</a>
    <a class="px-wa" href={waGeneric(lang)} target="_blank" rel="noopener" aria-label={c.nav.whatsapp}><Icon name="whatsapp" /></a>
  </div>
</div>
<div class="px-progress" aria-hidden="true"></div>

<main id="contenido">
  {/* ── Portada ── */}
  <section class="px-sec px-hero px-orange" id={id('home')} data-tone="orange">
    <div class="px-tone" data-px-tone="hero" aria-hidden="true"></div>
    <div class="px-wrap">
      <Headline h={x.hero.title} as="h1" class="px-mega" label={c.home.h1} />
      <p class="px-lead" data-up style="--d:.75s">{c.home.lead}</p>
      <div class="px-actions" data-up style="--d:.95s">
        <a class="px-btn px-btn--solid" href={waGeneric(lang)} target="_blank" rel="noopener" data-cta><Icon name="whatsapp" />{c.home.primary}</a>
        <a class="px-btn" href={path(lang, 'refs')}>{c.home.secondary}<Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  {/* ── Quiénes somos ── */}
  <section class="px-sec px-paper px-about" id={id('about')} data-tone="paper">
    <div class="px-tone" data-px-tone="about" aria-hidden="true"></div>
    <div class="px-wrap">
      <p class="px-mono" data-up style="--d:.05s">{x.about.kicker}</p>
      <Headline h={x.about.title} class="px-mega" />
      <p class="px-lead" data-up style="--d:.6s">{x.about.lead}</p>
    </div>
  </section>

  {/* ── Servicios (índice) ── */}
  <section class="px-sec px-ink px-grid" id={id('services')} data-tone="ink">
    <div class="px-wrap">
      <Headline h={x.services.title} />
      <ol class="px-index" data-up style="--d:.45s">
        {
          SERVICES.map((s, k) => (
            <li>
              <a href={`#${s.section[lang]}`}>
                <b aria-hidden="true">{NUM(k + 1)}</b>
                <span>{s.name[lang]}</span>
                <Icon name="arrow-right" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ── Fichas de servicio ── */}
  {
    SERVICES.map((s, k) => {
      const tone = SVC_TONE[s.id];
      const art = still[s.id];
      return (
        <section class:list={['px-sec', `px-${tone}`]} id={s.section[lang]} data-tone={tone}>
          <div class="px-wrap">
            <div class:list={['px-svc', { 'px-svc--flip': k % 2 === 1 }]}>
              <div class="px-svc-head">
                <p class="px-mono" data-up style="--d:.05s">
                  {NUM(k + 1)} — {s.name[lang]}
                </p>
                <Headline h={x.service[s.id]} label={`${s.name[lang]}: ${[...x.service[s.id].lines, x.service[s.id].em ?? ''].join(' ')}`} />
                <ul class="px-toggles" data-px-toggles aria-label={c.services.fields.includes}>
                  {shortIncludes(s.id).map((l, n) => (
                    <li style={`--n:${n}`}>
                      <span>{l.text}</span>
                      <span class="px-switch" aria-hidden="true" />
                    </li>
                  ))}
                </ul>
                <div class="px-actions" data-up style="--d:.4s">
                  <a class="px-btn px-btn--solid" href={waServiceOf(lang, s.id)} target="_blank" rel="noopener" aria-label={c.services.whatsappFor(s.name[lang])}>
                    <Icon name="whatsapp" />
                    {c.home.primary}
                  </a>
                </div>
              </div>
              <div class="px-svc-art" data-up style={`--d:.2s;--cols:${COLS}`} data-px-3d={s.id} data-dark={tone === 'ink' ? '' : undefined} aria-hidden="true">
                <pre class="a">{art.a}</pre>
                <pre class="b">{art.b}</pre>
              </div>
            </div>
          </div>
        </section>
      );
    })
  }

  {/* ── Ejemplos ── */}
  <section class="px-sec px-paper" id={id('samples')} data-tone="paper">
    <div class="px-wrap">
      <p class="px-mono" data-up style="--d:.05s">{x.samples.kicker}</p>
      <Headline h={x.samples.title} />
      <div class="px-samples" data-up style="--d:.45s">
        {
          refs.map((r) => (
            <article class="px-sample">
              <picture>
                <source type="image/avif" srcset={poster(r.slug, 'thumb', 'avif')} />
                <img src={poster(r.slug, 'thumb', 'webp')} width="640" height="400" alt="" loading="lazy" decoding="async" />
              </picture>
              <div class="px-sample-body">
                <p class="px-mono">{r.sector[lang]}</p>
                <h3>{r.name}</h3>
                <div class="px-sample-actions">
                  <a href={path(lang, 'ref', { slug: r.slug })} aria-label={c.samples.viewFor(r.name)}>
                    {c.samples.view}
                  </a>
                  <a class="solid" href={refWhatsApp(lang, [r])} target="_blank" rel="noopener" aria-label={c.samples.wantFor(r.name)}>
                    {c.samples.want}
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <div class="px-actions" data-up style="--d:.6s">
        <a class="px-btn" href={path(lang, 'refs')}>{c.samples.all(refs.length)}<Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  {/* ── Proceso ── */}
  <section class="px-sec px-orange" id={id('process')} data-tone="orange">
    <div class="px-tone" data-px-tone="process" aria-hidden="true"></div>
    <div class="px-wrap">
      <h2 class="px-mono" data-up style="--d:.05s">{x.process.kicker}</h2>
      <ol class="px-steps" data-up style="--d:.2s">
        {
          x.process.steps.map((st) => (
            <li>
              <span class="big">{st.big}</span>
              <span class="px-em">{st.em}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ── Contacto ── */}
  <section class="px-sec px-ink" id={id('contact')} data-tone="ink">
    <div class="px-tone" data-px-tone="contact" aria-hidden="true"></div>
    <div class="px-wrap">
      <Headline h={x.contact.title} class="px-mega" />
      <div class="px-actions" data-up style="--d:.6s">
        <a class="px-btn px-btn--solid" href={waGeneric(lang)} target="_blank" rel="noopener"><Icon name="whatsapp" />{c.contact.primary}</a>
      </div>
      <dl class="px-contact" data-up style="--d:.75s">
        <div class="px-row">
          <dt>{c.contact.email}</dt>
          <dd><a href={`mailto:${brand.contact.email}`}>{brand.contact.email}</a></dd>
        </div>
        <div class="px-row">
          <dt>{c.contact.phone}</dt>
          <dd><a href={`tel:${brand.contact.phone}`}>{brand.contact.whatsapp.display}</a></dd>
        </div>
      </dl>
      <div class="px-social" data-up style="--d:.85s">
        {socials.map(([k, href]) => <a href={href} target="_blank" rel="noopener me">{c.contact.social[k]}</a>)}
      </div>
      <div class="px-footer px-mono" data-up style="--d:.9s">
        <span>{brand.name} · Santo Domingo</span><span>©{new Date().getFullYear()}</span>
      </div>
    </div>
  </section>
</main>

<script>
  import '../../scripts/v3.ts';
</script>
