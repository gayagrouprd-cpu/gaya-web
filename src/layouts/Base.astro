---
import brand from '../../brand.json';
import { oklchToHex } from '../lib/color.mjs';
import { alternates, url, type Lang, type RouteKey, type RouteParams } from '../routes';
import { t } from '../i18n/copy';
// `?url` hace que Vite les ponga hash, igual que a los @font-face de fonts.css (mismo archivo = misma URL).
import bricolageLatin from '../../node_modules/@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import geistMonoLatin from '../../node_modules/@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import geistMonoSymbols from '../../node_modules/@fontsource-variable/geist-mono/files/geist-mono-symbols2-wght-normal.woff2?url';
import archivoWdth from '../../node_modules/@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import bodoniItalic from '../../node_modules/@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-italic.woff2?url';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/ascii.css';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  routeKey?: RouteKey;
  params?: RouteParams;
  ogImage?: string;
  noindex?: boolean;
  themeColor?: string;
  jsonLd?: Record<string, unknown>;
  /** Gramática visual de los controles: «cartel» = rótulos con sombra en bloque (la portada); «classic» = la actual (galería, visor, 404). */
  ui?: 'cartel' | 'classic' | 'poster';
  /** Precarga las fuentes del inicio: Geist Mono `latin` (el `h1` es el LCP), Bricolage `latin` (lead y párrafos) y Geist Mono `symbols2` (cajas y
   *  bloques del arte en el DOM). Solo donde hay arte: si la página no usa un archivo, Chrome avisa por consola. La galería, el visor y el 404
   *  («classic») usan una sola familia (mono, ver base.css) y precargan solo su `latin`. */
  preloadMono?: boolean;
}

const {
  lang,
  title,
  description = brand.description[lang],
  routeKey,
  params = {},
  ogImage = lang === 'en' ? '/og-en.jpg' : '/og.jpg',
  noindex = false,
  themeColor = oklchToHex('oklch(0.15 0.035 264)'),
  jsonLd,
  ui = routeKey === 'home' ? 'cartel' : 'classic',
  preloadMono = false,
} = Astro.props;

// Precargas de fuentes (tipografía mixta). Inicio (`preloadMono`): el LCP es el `h1`, en Geist Mono 800, así que su archivo `latin` va primero y SIN
// `fetchpriority` (las fuentes precargadas ya son de prioridad alta); Bricolage `latin` (lead y párrafos) viaja a la par y `symbols2`, que solo
// pinta el arte en el DOM, espera con prioridad baja. Galería, visor y 404: una sola fuente, la mono. Medido con Lighthouse móvil (mediana de 5, ES):
// con dos familias y sin precargas la galería daba 2,7 s de LCP; con una familia y su precarga, 2,03 s (el visor, 2,1 s).
const canonical = routeKey ? url(lang, routeKey, params) : undefined;
const alts = routeKey ? alternates(routeKey, params) : [];
const ogAbs = new URL(ogImage, brand.site).href;
const locale = lang === 'es' ? 'es_DO' : 'en_US';

// Guardia de red del sitio: nada sale de este origen. En desarrollo no se aplica (Vite inyecta código).
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "frame-src 'self'",
  "media-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="dark" />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogAbs} />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@GayaGroupRD" />
    {ui === 'poster' && <link rel="preload" href={archivoWdth} as="font" type="font/woff2" crossorigin />}
    {ui === 'poster' && <link rel="preload" href={bodoniItalic} as="font" type="font/woff2" crossorigin />}
    {(preloadMono || ui === 'classic') && <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />}
    {preloadMono && <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />}
    {preloadMono && <link rel="preload" href={geistMonoSymbols} as="font" type="font/woff2" crossorigin fetchpriority="low" />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body data-ui={ui}>
    <a class="skip" href="#contenido">{t(lang).nav.skip}</a>
    <slot />
  </body>
</html>
