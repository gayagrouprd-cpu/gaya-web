---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import LIcon from './LIcon.astro';
import Icon from './Icon.astro';
import ContactData from './ContactData.astro';
import { builtRefs, poster, stripHeight, types, type RefType } from '../lib/refs';
import { path, type Lang } from '../routes';
import { t } from '../i18n/copy';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang).gallery;
const refs = builtRefs();
const presentTypes = (Object.keys(types) as RefType[]).filter((k) => refs.some((r) => r.type === k));
---

<Base lang={lang} title={`${c.metaTitle} · Gaya Group`} description={c.metaDescription} routeKey="refs">
  <Nav lang={lang} routeKey="refs" />
  <main id="contenido" class="gal">
    <header class="gal__head">
      <h1>{c.title}</h1>
      <div class="gal__filters" role="group" aria-label={c.filter}>
        <button type="button" class="chip" data-filter="all" aria-pressed="true">
          <LIcon name="layout-grid" />
          {c.all}
        </button>
        {
          presentTypes.map((k) => (
            <button type="button" class="chip" data-filter={k} aria-pressed="false">
              <LIcon name={types[k].icon} />
              {types[k][lang]}
            </button>
          ))
        }
      </div>
    </header>

    <p class="sr-only" aria-live="polite" id="gal-count">{c.count(refs.length)}</p>

    <ul class="grid" id="gal-grid">
      {
        refs.map((r, i) => (
          <li class="card" data-type={r.type} data-slug={r.slug} style={`--ref-surface:${r.palette.surface};--ref-accent:${r.palette.accent};--tour:${Math.round(Math.min(16, Math.max(5, stripHeight(r.slug) / 380)))}s`}>
            <a class="card__link" href={path(lang, 'ref', { slug: r.slug })} data-ref-link>
              <span class="card__window">
                <picture>
                  <source type="image/avif" srcset={poster(r.slug, 'strip', 'avif')} />
                  <img class="card__strip" src={poster(r.slug, 'strip', 'webp')} width="900" height={stripHeight(r.slug)} alt="" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
                </picture>
              </span>
              <span class="card__meta">
                <span class="card__name">
                  <span class="dots" aria-hidden="true">
                    <i style="background:var(--ref-surface)" />
                    <i style="background:var(--ref-accent)" />
                  </span>
                  {r.name}
                </span>
                <span class="card__sector">
                  <LIcon name={r.icon} />
                  {r.sector[lang]}
                </span>
                <span class="card__type" title={types[r.type][lang]}>
                  <LIcon name={types[r.type].icon} />
                  <span class="sr-only">{types[r.type][lang]}</span>
                </span>
              </span>
            </a>
            <button type="button" class="fav" data-fav={r.slug} aria-pressed="false" aria-label={c.fav(r.name)} data-label-on={c.unfav(r.name)} data-label-off={c.fav(r.name)}>
              <LIcon name="heart" />
            </button>
          </li>
        ))
      }
    </ul>
  </main>

  <div class="tray" id="tray" hidden>
    <span class="tray__count"><LIcon name="heart" /><b id="tray-n">0</b><span class="sr-only">{c.favorites}</span></span>
    <a class="btn btn--primary" id="tray-cta" href="#" target="_blank" rel="noopener"><Icon name="whatsapp" />{c.sendFavs}</a>
  </div>

  <ContactData lang={lang} />
  <script>
    import { initGallery } from '../scripts/gallery';
    initGallery();
  </script>
</Base>

<style>
  .gal {
    padding: calc(env(safe-area-inset-top, 0px) + 6.5rem) var(--gutter) 8rem;
    max-width: 88rem;
    margin-inline: auto;
  }
  /* El resplandor va en el lienzo entero: si va en .gal, el ancho máximo lo corta con un borde visible */
  :global(body:has(.gal)) {
    background: radial-gradient(60rem 30rem at 15% -5%, color-mix(in oklch, var(--glow-1) 40%, transparent), transparent 70%) no-repeat, var(--surface);
  }
  .gal__head {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }
  h1 {
    font-size: var(--text-display);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }
  .gal__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--muted);
    font-size: var(--text-s);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }
  .chip :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--surface);
  }
  @media (hover: hover) {
    .chip:hover:not([aria-pressed='true']) {
      color: var(--ink);
      border-color: color-mix(in oklch, var(--ink) 45%, transparent);
    }
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-7) var(--space-6);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }
  @media (min-width: 48rem) {
    .card:nth-child(3n + 2) {
      margin-top: clamp(1.5rem, 5vw, 4rem);
    }
  }
  .card {
    position: relative;
  }
  .card[hidden] {
    display: none;
  }
  .card__link {
    display: grid;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
  }
  .card__window {
    container-type: size;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--ref-surface);
    transition: border-color var(--dur-2) var(--ease-out), transform var(--dur-3) var(--ease-out);
  }
  .card__strip {
    width: 100%;
    height: auto;
    transform: translateY(0);
    transition: transform 0.7s var(--ease-out);
    will-change: auto;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .card__link:hover .card__strip,
    .card__link:focus-visible .card__strip {
      transform: translateY(calc(-100% + 100cqh));
      transition: transform var(--tour) linear 0.15s;
      will-change: transform;
    }
    .card__link:hover .card__window {
      border-color: color-mix(in oklch, var(--ink) 45%, transparent);
      transform: translateY(-3px);
    }
  }
  .card__link:focus-visible {
    outline-offset: 6px;
    border-radius: var(--radius-l);
  }
  .card__meta {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'name type'
      'sector type';
    align-items: center;
    column-gap: var(--space-3);
  }
  .card__name {
    grid-area: name;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-l);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }
  .dots {
    display: inline-flex;
  }
  .dots i {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    box-shadow: 0 0 0 1px color-mix(in oklch, var(--ink) 35%, transparent);
  }
  .dots i + i {
    margin-inline-start: -0.25rem;
  }
  .card__sector {
    grid-area: sector;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--muted);
    font-size: var(--text-s);
  }
  .card__sector :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  .card__type {
    grid-area: type;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--muted);
  }

  .fav {
    position: absolute;
    inset-block-start: var(--space-3);
    inset-inline-end: var(--space-3);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in oklch, var(--ink) 25%, transparent);
    border-radius: 50%;
    background: color-mix(in oklch, var(--surface) 70%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--ink);
    cursor: pointer;
    transition: transform var(--dur-2) var(--ease-out), background-color var(--dur-2) var(--ease-out);
  }
  .fav[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .fav[aria-pressed='true'] :global(.icon) {
    fill: currentColor;
  }
  @media (hover: hover) {
    .fav:hover {
      transform: scale(1.08);
    }
  }

  .tray {
    position: fixed;
    z-index: var(--z-toast);
    inset-inline: 0;
    bottom: calc(env(safe-area-inset-bottom, 0px) + var(--space-4));
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    padding-inline: var(--space-4);
    pointer-events: none;
  }
  .tray[hidden] {
    display: none;
  }
  .tray > * {
    pointer-events: auto;
  }
  .tray__count {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 3rem;
    padding: 0 var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: color-mix(in oklch, var(--surface) 80%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    font-weight: 700;
  }
  .tray__count :global(.icon) {
    fill: var(--accent);
    color: var(--accent);
  }
</style>
