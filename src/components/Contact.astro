---
// Contacto (#contacto / #contact): el cartel TÚ, el cierre. Sobre el cartel, el `h2` y el botón de WhatsApp (pozo «ink»);
// debajo, la placa con el correo (Copiar / Copiado), el teléfono, las redes y la firma; y el pie con la hora de Santo Domingo.
// Sin formulario ni captcha. «Copiado» es la única región `role="status"` de la página (R1, 4.1.3).
import Icon from './Icon.astro';
import PosterSection from './PosterSection.astro';
import Plate from './Plate.astro';
import brand from '../../brand.json';
import { CONTACT, SOCIALS } from '../data/site.ts';
import { sectionId } from '../data/services.ts';
import { waGeneric } from '../lib/wa.ts';
import { t } from '../i18n/copy.ts';
import type { Lang } from '../routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang).contact;
const f = t(lang).footer;
---

<PosterSection scene="tu" id={sectionId(lang, 'contact')} labelledby="contact-h" class="contact">
  <div class="stage">
    <div class="stage__in" data-well="ink">
      <h2 id="contact-h">{c.h2}</h2>
      <a class="btn btn--primary contact__cta" href={waGeneric(lang)} target="_blank" rel="noopener">
        <Icon name="whatsapp" />
        {c.primary}
      </a>
    </div>
  </div>
  <div class="wrap">
    <Plate class="contact__plate">
      <dl class="rows">
        <div class="rows__row">
          <dt>{c.email}</dt>
          <dd class="mail">
            <a class="mail__addr" id="mail-addr" href={CONTACT.mailto}>{CONTACT.email}</a>
            <button class="btn btn--ghost btn--s" id="mail-copy" type="button" data-copy={CONTACT.email} data-done={c.copied} aria-labelledby="mail-copy mail-addr">{c.copy}</button>
            <span class="mail__done" role="status"></span>
          </dd>
        </div>
        <div class="rows__row">
          <dt>{c.phone}</dt>
          <dd><a href={CONTACT.tel}>{CONTACT.phone}</a></dd>
        </div>
      </dl>
      <ul class="social">
        {
          SOCIALS.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" aria-label={c.social[s.key]}>
                <Icon name={s.key} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="sign"><span class="sign__name">{c.signature}</span></p>
    </Plate>
    <footer class="foot">
      <p data-well="muted" data-clock data-lang={lang} data-tz={brand.timezone} data-tpl={f.line('{time}')}>{f.rights}</p>
    </footer>
  </div>
</PosterSection>

<script>
  import '../scripts/clock.ts';
  import '../scripts/copy-mail.ts';
</script>
