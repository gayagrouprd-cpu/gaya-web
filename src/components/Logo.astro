---
// Marca provisional en texto + un orbe de luz. Cuando llegue el logo del diseñador, se cambia solo este archivo.
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a class="logo" href={href} aria-label={label}>
  <span class="logo__orb" aria-hidden="true"></span>
  <span class="logo__text"><span class="logo__name">Gaya</span> <span class="logo__sub">Digital</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    text-decoration: none;
    color: var(--ink);
  }
  .logo__orb {
    position: relative;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, var(--glow-3), var(--accent) 46%, var(--glow-1) 100%);
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--ink) 30%, transparent);
    flex: none;
  }
  .logo__text {
    font-size: var(--text-m);
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .logo__name {
    font-weight: 700;
  }
  .logo__sub {
    font-weight: 400;
    color: var(--muted);
  }
</style>
