---
// Hasta 5 referencias flotando sobre la luz (solo escritorio). Cada tarjeta lleva al visor de esa referencia.
import { builtRefs, poster } from '../lib/refs';
import { path, type Lang } from '../routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const refs = builtRefs();
// Una por tipo mientras se pueda, para que la muestra sea variada
const picked: typeof refs = [];
for (const r of refs) if (!picked.some((p) => p.type === r.type) && picked.length < 5) picked.push(r);
for (const r of refs) if (!picked.includes(r) && picked.length < 5) picked.push(r);
// Posiciones en abanico (respecto a la esquina inferior derecha de la portada)
const layout = [
  { r: '30%', b: '35%', rot: -5, w: '17rem', depth: 14 },
  { r: '9%', b: '26%', rot: 4, w: '19rem', depth: 24 },
  { r: '2%', b: '5%', rot: -3, w: '17rem', depth: 30 },
  { r: '30%', b: '9%', rot: 5, w: '15rem', depth: 18 },
  { r: '50%', b: '24%', rot: -6, w: '14rem', depth: 10 },
];
---

{
  picked.length > 0 && (
    <div class="hcards" aria-label={lang === 'es' ? 'Referencias' : 'References'}>
      {picked.map((r, i) => (
        <a
          class="hcard"
          href={path(lang, 'ref', { slug: r.slug })}
          style={`--r:${layout[i].r};--b:${layout[i].b};--rot:${layout[i].rot}deg;--w:${layout[i].w};--depth:${layout[i].depth};--i:${i};--surface-ref:${r.palette.surface}`}
          aria-label={`${r.name} · ${r.sector[lang]}`}
        >
          <picture>
            <source type="image/avif" srcset={poster(r.slug, 'thumb', 'avif')} />
            <img src={poster(r.slug, 'thumb', 'webp')} width="640" height="400" alt="" decoding="async" fetchpriority="low" />
          </picture>
        </a>
      ))}
    </div>
  )
}

<style>
  .hcards {
    display: none;
  }
  @media (min-width: 68rem) and (min-height: 38rem) {
    .hcards {
      display: block;
      position: absolute;
      z-index: var(--z-content);
      inset: 18% var(--gutter) 6% 46%;
      pointer-events: none;
      perspective: 1400px;
    }
    .hcard {
      position: absolute;
      right: var(--r);
      bottom: var(--b);
      width: var(--w);
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border: 1px solid color-mix(in oklch, var(--ink) 28%, transparent);
      border-radius: var(--radius-m);
      background: var(--surface-ref);
      pointer-events: auto;
      transform: translate3d(calc(var(--px, 0) * var(--depth) * 1px), calc(var(--py, 0) * var(--depth) * 1px), 0) rotate(var(--rot))
        rotateY(calc(var(--px, 0) * 6deg)) rotateX(calc(var(--py, 0) * -5deg));
      transition:
        transform 500ms var(--ease-out),
        border-color var(--dur-2) var(--ease-out);
      animation: hcard-in 900ms var(--ease-out) backwards, hcard-float 9s ease-in-out infinite alternate;
      animation-delay: calc(1100ms + var(--i) * 110ms), calc(2200ms + var(--i) * -1800ms);
    }
    .hcard img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
    }
    .hcard:hover,
    .hcard:focus-visible {
      z-index: 9;
      border-color: var(--ink);
      transform: translate3d(calc(var(--px, 0) * var(--depth) * 1px), calc(var(--py, 0) * var(--depth) * 1px - 8px), 0) rotate(0deg) scale(1.06);
    }
    @keyframes hcard-in {
      from {
        opacity: 0;
        translate: 0 2.5rem;
      }
    }
    @keyframes hcard-float {
      from {
        translate: 0 -0.4rem;
      }
      to {
        translate: 0 0.5rem;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .hcard {
        animation: none;
        transition: none;
      }
    }
  }
</style>

<script>
  // Parallax suave con el puntero (solo puntero fino y sin «movimiento reducido»)
  const box = document.querySelector<HTMLElement>('.hcards');
  if (box && matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const hero = box.closest<HTMLElement>('.hero') ?? document.body;
    let raf = 0;
    let tx = 0;
    let ty = 0;
    hero.addEventListener(
      'pointermove',
      (e) => {
        const r = hero.getBoundingClientRect();
        tx = ((e.clientX - r.left) / r.width - 0.5) * 2;
        ty = ((e.clientY - r.top) / r.height - 0.5) * 2;
        if (!raf)
          raf = requestAnimationFrame(() => {
            raf = 0;
            box.style.setProperty('--px', tx.toFixed(3));
            box.style.setProperty('--py', ty.toFixed(3));
          });
      },
      { passive: true },
    );
  }
</script>
