---
// Inicio en estilo «cartel editorial» + ASCII (decisión del dueño, 5-oct-2026). Un cartel por sección, a pantalla completa,
// alternando naranja, crema y negro. El contenido real sale de copy.ts, services.ts y facts.ts; los titulares de cartel, de v3.ts.
import Icon from '../Icon.astro';
import brand from '../../../brand.json';
import { t, aboutRows } from '../../i18n/copy';
import { v3, type Headline } from '../../i18n/v3';
import { SERVICES, publishedIncludes, serviceFact, sectionId, type ServiceId } from '../../data/services';
import { SERVICE_ART } from '../../data/ascii-art';
import { waGeneric, waServiceOf } from '../../lib/wa';
import { builtRefs, poster, refWhatsApp } from '../../lib/refs';
import { path, otherLang, type Lang } from '../../routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
const x = v3[lang];
const other = otherLang(lang);
const refs = builtRefs();
const id = (k: Parameters<typeof sectionId>[1]) => sectionId(lang, k);

// Tonos de cada cartel (se alternan; el de la portada es naranja como la referencia)
const SVC_TONE: Record<ServiceId, 'orange' | 'paper' | 'ink'> = { web: 'orange', automation: 'paper', marketing: 'ink', it: 'orange' };

/** Parte un titular en palabras animables. Devuelve bloques: líneas en mayúsculas y el acento en cursiva en su sitio. */
function blocks(h: Headline) {
  const out: Array<{ kind: 'line' | 'em'; words: string[]; dot?: boolean }> = [];
  const lines = h.lines.map((l) => l);
  const at = h.emBefore ?? lines.length;
  lines.forEach((l, k) => {
    if (k === at && h.em) out.push({ kind: 'em', words: h.em.split(' ') });
    out.push({ kind: 'line', words: l.split(' ') });
  });
  if (at >= lines.length && h.em) out.push({ kind: 'em', words: h.em.split(' ') });
  // El punto final de la última línea en mayúsculas se dibuja como una bola (decoración)
  const lastLine = [...out].reverse().find((b) => b.kind === 'line');
  if (lastLine) {
    const w = lastLine.words[lastLine.words.length - 1];
    if (w.endsWith('.')) {
      lastLine.words[lastLine.words.length - 1] = w.slice(0, -1);
      lastLine.dot = true;
    }
  }
  return out;
}
const plain = (h: Headline) => {
  const b = blocks(h);
  return b.map((x) => x.words.join(' ')).join(' ');
};
let wi = 0;
const nextI = () => wi++;
const resetI = () => {
  wi = 0;
};

const time = new Intl.DateTimeFormat(lang === 'es' ? 'es-DO' : 'en-US', { timeZone: 'America/Santo_Domingo', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date());
const socials = Object.entries(brand.social) as Array<[keyof typeof c.contact.social, string]>;
const NUM = (n: number) => String(n).padStart(2, '0');
/** Ancho del arte en columnas: el tamaño de letra se ajusta para que llene su caja. */
const artCols = (sid: ServiceId) => Math.max(...SERVICE_ART[sid].split('\n').map((l) => l.length));
---

<div class="px-chrome">
  <div class="px-top">
    <a class="px-brand" href={`#${id('home')}`} aria-label={brand.name}><i aria-hidden="true"></i><span>{brand.name}</span></a>
    <nav class="px-links" aria-label={c.nav.label}>
      <a href={`#${id('about')}`}>{c.nav.about}</a>
      <a href={`#${id('services')}`}>{c.nav.services}</a>
      <a href={`#${id('samples')}`}>{c.nav.samples}</a>
      <a href={`#${id('process')}`}>{c.nav.process}</a>
      <a href={`#${id('contact')}`}>{c.nav.contact}</a>
    </nav>
    <a class="px-lang" href={path(other, 'home')} hreflang={other} lang={other} aria-label={c.nav.switchTo.label}>{c.nav.switchTo.code}</a>
    <a class="px-wa" href={waGeneric(lang)} target="_blank" rel="noopener" aria-label={c.nav.whatsapp}><Icon name="whatsapp" /></a>
  </div>
  <div class="px-foot" aria-hidden="true">
    <span data-px-label>01 · {c.nav.label}</span>
    <span class="px-where">{x.chrome.place} · <span data-px-clock>{time}</span></span>
  </div>
</div>
<div class="px-progress" aria-hidden="true"></div>

<main id="contenido">
  {/* ── Portada ── */}
  <section class="px-sec px-hero px-orange" id={id('home')} data-tone="orange" data-label={`01 · ${lang === 'es' ? 'Inicio' : 'Home'}`}>
    <div class="px-tone" data-px-tone="hero" aria-hidden="true"></div>
    <div class="px-wrap">
      <p class="px-mono" data-up style="--d:.05s">{x.hero.kicker}</p>
      {resetI()}
      <h1 class="px-mega" aria-label={c.home.h1}>
        {
          blocks(x.hero.title).map((b) => (
            <span class:list={[b.kind === 'em' ? 'px-em' : 'line']} aria-hidden="true">
              {b.words.map((w, wk) => (
                <>
                  <span class="w"><span style={`--i:${nextI()}`}>{w}</span></span>{b.dot && wk === b.words.length - 1 ? <span class="px-dot" /> : ' '}
                </>
              ))}
            </span>
          ))
        }
      </h1>
      <p class="px-lead" data-up style="--d:.75s">{c.home.lead}</p>
      <div class="px-actions" data-up style="--d:.95s">
        <a class="px-btn px-btn--solid" href={waGeneric(lang)} target="_blank" rel="noopener" data-cta><Icon name="whatsapp" />{c.home.primary}</a>
        <a class="px-btn" href={path(lang, 'refs')}>{c.home.secondary}<Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  {/* ── Quiénes somos ── */}
  <section class="px-sec px-paper" id={id('about')} data-tone="paper" data-label={`02 · ${c.nav.about}`}>
    <div class="px-tone" data-px-tone="about" aria-hidden="true"></div>
    <div class="px-wrap">
      <p class="px-mono" data-up style="--d:.05s">{x.about.kicker}</p>
      {resetI()}
      <h2 class="px-mega" aria-label={plain(x.about.title)}>
        {
          blocks(x.about.title).map((b) => (
            <span class:list={[b.kind === 'em' ? 'px-em' : 'line']} aria-hidden="true">
              {b.words.map((w, wk) => (
                <>
                  <span class="w"><span style={`--i:${nextI()}`}>{w}</span></span>{b.dot && wk === b.words.length - 1 ? <span class="px-dot" /> : ' '}
                </>
              ))}
            </span>
          ))
        }
      </h2>
      <dl class="px-rows" data-up style="--d:.55s">
        {
          aboutRows(lang)
            .filter((r) => r.id !== 'brand')
            .map((r) => (
              <div class="px-row">
                <dt>{r.label}</dt>
                <dd>{r.value}</dd>
              </div>
            ))
        }
      </dl>
      <div class="px-sign px-mono" data-up style="--d:.8s"><span>{c.about.signature}</span><span>{c.about.place} · {time}</span></div>
    </div>
  </section>

  {/* ── Servicios (índice) ── */}
  <section class="px-sec px-ink px-grid" id={id('services')} data-tone="ink" data-label={`03 · ${c.nav.services}`}>
    <div class="px-wrap">
      <p class="px-mono px-kicker" data-up style="--d:.05s"><b>&gt;</b>{x.services.kicker}</p>
      {resetI()}
      <h2 class="px-h2" aria-label={plain(x.services.title)}>
        {
          blocks(x.services.title).map((b) => (
            <span class:list={[b.kind === 'em' ? 'px-em' : 'line']} aria-hidden="true">
              {b.words.map((w, wk) => (
                <>
                  <span class="w"><span style={`--i:${nextI()}`}>{w}</span></span>{b.dot && wk === b.words.length - 1 ? <span class="px-dot" /> : ' '}
                </>
              ))}
            </span>
          ))
        }
      </h2>
      <div class="px-index" data-up style="--d:.45s">
        {
          SERVICES.map((s, k) => (
            <div class="px-index-row">
              <b aria-hidden="true">{NUM(k + 1)}</b>
              <h3>
                <a href={`#${s.section[lang]}`}>{s.name[lang]}</a>
              </h3>
              <p>{s.promise[lang]}</p>
              <a class="px-btn" href={waServiceOf(lang, s.id)} target="_blank" rel="noopener" aria-label={c.services.whatsappFor(s.name[lang])}>
                <Icon name="whatsapp" />
                {c.services.whatsapp}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Fichas de servicio ── */}
  {
    SERVICES.map((s, k) => {
      const tone = SVC_TONE[s.id];
      const fact = serviceFact(s);
      const head = x.service[s.id];
      resetI();
      return (
        <section class:list={['px-sec', `px-${tone}`]} id={s.section[lang]} data-tone={tone} data-label={`${NUM(k + 4)} · ${s.name[lang]}`}>
          <div class="px-wrap">
            <div class:list={['px-svc', { 'px-svc--flip': k % 2 === 1 }]}>
              <div class="px-svc-head">
                <p class="px-mono" data-up style="--d:.05s">
                  {NUM(k + 1)} — {s.name[lang]}
                </p>
                <h2 class="px-h2" aria-label={`${s.name[lang]}: ${plain(head)}`}>
                  {blocks(head).map((b) => (
                    <span class:list={[b.kind === 'em' ? 'px-em' : 'line']} aria-hidden="true">
                      {b.words.map((w, wk) => (
                        <>
                          <span class="w">
                            <span style={`--i:${nextI()}`}>{w}</span>
                          </span>{' '}
                        </>
                      ))}
                    </span>
                  ))}
                </h2>
                <p class="px-lead" data-up style="--d:.5s">
                  {s.promise[lang]}
                </p>
                <ul class="px-toggles" data-px-toggles aria-label={c.services.fields.includes}>
                  {publishedIncludes(s, lang).map((line, n) => (
                    <li style={`--n:${n}`}>
                      <span>
                        <small>{NUM(n + 1)}</small>
                        {line}
                      </span>
                      <span class="px-switch" aria-hidden="true" />
                    </li>
                  ))}
                </ul>
                <div class="px-actions" data-up style="--d:.4s">
                  <a class="px-btn px-btn--solid" href={waServiceOf(lang, s.id)} target="_blank" rel="noopener" aria-label={c.services.whatsappFor(s.name[lang])}>
                    <Icon name="whatsapp" />
                    {c.home.primary}
                  </a>
                </div>
              </div>
              <div class="px-svc-art" data-up style="--d:.35s" aria-hidden="true">
                <pre class="px-art" data-px-type style={`--cols:${artCols(s.id)}`}>{SERVICE_ART[s.id]}</pre>
              </div>
            </div>
            <div class="px-cards" data-up style="--d:.3s">
              <div class="px-card px-card--ink">
                <h4>{c.services.fields.audience}</h4>
                <p>{s.audience[lang]}</p>
              </div>
              <div class="px-card px-card--line">
                <h4>{c.services.fields.needs}</h4>
                <p>{s.needs[lang]}</p>
              </div>
              <div class="px-card px-card--ink">
                <h4>{c.services.fields.result}</h4>
                <p>{s.result[lang]}</p>
              </div>
            </div>
            {fact && (
              <div class="px-fact" data-up style="--d:.35s">
                <p>{fact.text[lang]}</p>
                <a class="px-mono" href={fact.src} rel="noopener" target="_blank">
                  {c.services.source(fact.source[lang])}
                </a>
              </div>
            )}
          </div>
        </section>
      );
    })
  }

  {/* ── Ejemplos ── */}
  <section class="px-sec px-paper" id={id('samples')} data-tone="paper" data-label={`08 · ${c.nav.samples}`}>
    <div class="px-wrap">
      <p class="px-mono" data-up style="--d:.05s">{x.samples.kicker}</p>
      {resetI()}
      <h2 class="px-h2" aria-label={plain(x.samples.title)}>
        {
          blocks(x.samples.title).map((b) => (
            <span class:list={[b.kind === 'em' ? 'px-em' : 'line']} aria-hidden="true">
              {b.words.map((w, wk) => (
                <>
                  <span class="w"><span style={`--i:${nextI()}`}>{w}</span></span>{b.dot && wk === b.words.length - 1 ? <span class="px-dot" /> : ' '}
                </>
              ))}
            </span>
          ))
        }
      </h2>
      <div class="px-samples" data-up style="--d:.45s">
        {
          refs.map((r) => (
            <article class="px-sample">
              <picture>
                <source type="image/avif" srcset={poster(r.slug, 'thumb', 'avif')} />
                <img src={poster(r.slug, 'thumb', 'webp')} width="640" height="400" alt="" loading="lazy" decoding="async" />
              </picture>
              <div class="px-sample-body">
                <p class="px-mono">{r.sector[lang]}</p>
                <h3>{r.name}</h3>
                <div class="px-sample-actions">
                  <a href={path(lang, 'ref', { slug: r.slug })} aria-label={c.samples.viewFor(r.name)}>
                    {c.samples.view}
                  </a>
                  <a class="solid" href={refWhatsApp(lang, [r])} target="_blank" rel="noopener" aria-label={c.samples.wantFor(r.name)}>
                    {c.samples.want}
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <div class="px-actions" data-up style="--d:.6s">
        <a class="px-btn" href={path(lang, 'refs')}>{c.samples.all(refs.length)}<Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  {/* ── Proceso ── */}
  <section class="px-sec px-orange" id={id('process')} data-tone="orange" data-label={`09 · ${c.nav.process}`}>
    <div class="px-tone" data-px-tone="process" aria-hidden="true"></div>
    <div class="px-wrap">
      <h2 class="px-mono" data-up style="--d:.05s">{x.process.kicker}</h2>
      <ol class="px-steps" data-up style="--d:.2s">
        {
          x.process.steps.map((st) => (
            <li>
              <span class="big">{st.big}</span>
              <span class="px-em">{st.em}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ── Contacto ── */}
  <section class="px-sec px-ink" id={id('contact')} data-tone="ink" data-label={`10 · ${c.nav.contact}`}>
    <div class="px-tone" data-px-tone="contact" aria-hidden="true"></div>
    <div class="px-wrap">
      <p class="px-mono px-kicker" data-up style="--d:.05s"><b>&gt;</b>{x.contact.kicker}</p>
      {resetI()}
      <h2 class="px-mega" aria-label={plain(x.contact.title)}>
        {
          blocks(x.contact.title).map((b) => (
            <span class:list={[b.kind === 'em' ? 'px-em' : 'line']} aria-hidden="true">
              {b.words.map((w, wk) => (
                <>
                  <span class="w"><span style={`--i:${nextI()}`}>{w}</span></span>{b.dot && wk === b.words.length - 1 ? <span class="px-dot" /> : ' '}
                </>
              ))}
            </span>
          ))
        }
      </h2>
      <div class="px-actions" data-up style="--d:.6s">
        <a class="px-btn px-btn--solid" href={waGeneric(lang)} target="_blank" rel="noopener"><Icon name="whatsapp" />{c.contact.primary}</a>
      </div>
      <dl class="px-contact" data-up style="--d:.75s">
        <div class="px-row">
          <dt>{c.contact.email}</dt>
          <dd><a href={`mailto:${brand.contact.email}`}>{brand.contact.email}</a></dd>
        </div>
        <div class="px-row">
          <dt>{c.contact.phone}</dt>
          <dd><a href={`tel:${brand.contact.phone}`}>{brand.contact.whatsapp.display}</a></dd>
        </div>
      </dl>
      <div class="px-social" data-up style="--d:.85s">
        {socials.map(([k, href]) => <a href={href} target="_blank" rel="noopener me">{c.contact.social[k]}</a>)}
      </div>
      <div class="px-footer px-mono" data-up style="--d:.9s">
        <span>{brand.name}</span><span>{c.footer.rights}</span><span>©{new Date().getFullYear()}</span>
      </div>
    </div>
  </section>
</main>

<script>
  import '../../scripts/v3.ts';
</script>
